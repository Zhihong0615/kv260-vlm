diff --git a/experiments/rm08/ffn_down_helper_smoke.c b/experiments/rm08/ffn_down_helper_smoke.c
new file mode 100644
index 0000000..55893a0
--- /dev/null
+++ b/experiments/rm08/ffn_down_helper_smoke.c
@@ -0,0 +1,111 @@
+#include "ggml.h"
+
+#include <inttypes.h>
+#include <math.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+int ggml_kv260_ffn_down_execute(struct ggml_tensor * dst);
+
+static int read_exact(const char * path, void * data, size_t size) {
+    FILE * f = fopen(path, "rb");
+    if (!f) return -1;
+    const size_t got = fread(data, 1, size, f);
+    const int extra = fgetc(f);
+    const int failed = ferror(f);
+    fclose(f);
+    return got == size && extra == EOF && !failed ? 0 : -1;
+}
+
+static void metrics(const float * actual, const float * reference, size_t n,
+                    double * max_abs, double * rmse, double * cosine) {
+    double sum_sq = 0.0, dot = 0.0, aa = 0.0, bb = 0.0;
+    *max_abs = 0.0;
+    for (size_t i = 0; i < n; ++i) {
+        const double a = actual[i], b = reference[i];
+        const double e = fabs(a - b);
+        if (e > *max_abs) *max_abs = e;
+        sum_sq += e * e;
+        dot += a * b;
+        aa += a * a;
+        bb += b * b;
+    }
+    *rmse = sqrt(sum_sq / (double) n);
+    *cosine = dot / sqrt(aa * bb);
+}
+
+static int run_case(const char * directory, int layer, int64_t active_n) {
+    const int64_t k = 4304, m = 1152;
+    const size_t w_bytes = (size_t) k * (size_t) m * sizeof(uint16_t);
+    const size_t x_bytes = (size_t) k * (size_t) active_n * sizeof(float);
+    const size_t y_bytes = (size_t) m * (size_t) active_n * sizeof(float);
+    char path[1024];
+    struct ggml_init_params init = { .mem_size = 64u * 1024u * 1024u, .mem_buffer = NULL, .no_alloc = false };
+    struct ggml_context * ctx = ggml_init(init);
+    if (!ctx) {
+        fprintf(stderr, "SMOKE_FAIL layer=%d reason=ggml_init\n", layer);
+        return 1;
+    }
+    struct ggml_tensor * w = ggml_new_tensor_2d(ctx, GGML_TYPE_F16, k, m);
+    struct ggml_tensor * x = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, k, active_n);
+    if (!w || !x) {
+        fprintf(stderr, "SMOKE_FAIL layer=%d reason=tensor_allocation\n", layer);
+        ggml_free(ctx);
+        return 1;
+    }
+    snprintf(path, sizeof(path), "%s/ffn_down-%d.weight.f16", directory, layer);
+    if (read_exact(path, w->data, w_bytes) != 0) goto read_fail;
+    snprintf(path, sizeof(path), "%s/ffn_down-%d.activation.f32", directory, layer);
+    if (read_exact(path, x->data, x_bytes) != 0) goto read_fail;
+
+    struct ggml_tensor * y = ggml_mul_mat(ctx, w, x);
+    if (!y || y->type != GGML_TYPE_F32 || y->ne[0] != m || y->ne[1] != active_n) {
+        fprintf(stderr, "SMOKE_FAIL layer=%d reason=matmul_shape\n", layer);
+        ggml_free(ctx);
+        return 1;
+    }
+    snprintf(path, sizeof(path), "ffn_down-%d", layer);
+    ggml_set_name(y, path);
+    char name[GGML_MAX_NAME];
+    memcpy(name, y->name, sizeof(name));
+
+    snprintf(path, sizeof(path), "%s/ffn_down-%d.output.f32", directory, layer);
+    float * reference = (float *) malloc(y_bytes);
+    if (!reference || read_exact(path, reference, y_bytes) != 0) {
+        fprintf(stderr, "SMOKE_FAIL layer=%d reason=reference_read\n", layer);
+        free(reference);
+        ggml_free(ctx);
+        return 1;
+    }
+    const int handled = ggml_kv260_ffn_down_execute(y);
+    double max_abs, rmse, cosine;
+    metrics((const float *) y->data, reference, (size_t) m * (size_t) active_n,
+            &max_abs, &rmse, &cosine);
+    const int pass = handled && max_abs <= 1.0e-3 && rmse <= 1.0e-4 && cosine >= 0.999;
+    printf("SMOKE_RESULT layer=%s status=%s K=%" PRId64 " M=%" PRId64 " N=%" PRId64
+           " max_abs=%.9g rmse=%.9g cosine=%.15g\n",
+           name, pass ? "PASS" : (handled ? "NUMERIC_FAIL" : "CPU_FALLBACK"),
+           k, m, active_n, max_abs, rmse, cosine);
+    free(reference);
+    ggml_free(ctx);
+    return pass ? 0 : 1;
+
+read_fail:
+    fprintf(stderr, "SMOKE_FAIL layer=%d reason=tensor_read path=%s\n", layer, path);
+    ggml_free(ctx);
+    return 1;
+}
+
+int main(int argc, char ** argv) {
+    if (argc != 2) {
+        fprintf(stderr, "usage: %s TENSOR_DIRECTORY\n", argv[0]);
+        return 2;
+    }
+    int status = 0;
+    status |= run_case(argv[1], 0, 1120);
+    status |= run_case(argv[1], 13, 280);
+    status |= run_case(argv[1], 26, 280);
+    return status ? 1 : 0;
+}
